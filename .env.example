# Copy to .env and fill in values. Never commit .env.

# Core
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres / Nile / Neon-compatible database URL
DATABASE_URL=

# Legacy JWT auth used by current /api/auth routes during migration
JWT_SECRET=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google Sign-In / Better Auth Google provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin dashboard code (required for admin actions)
# Set a real value locally; never ship a guessable PIN to production.
ADMIN_PIN=
VITE_ADMIN_EMAILS=

# Duffel (flights + stays)
DUFFEL_API_KEY=

# Hotelbeds (stays; served through /api/duffel/stays/search)
# Leave blank to disable the Hotelbeds provider.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_USE_TEST=false

# Events & Attractions (optional)
EVENTBRITE_TOKEN=
TICKETMASTER_API_KEY=
GETYOURGUIDE_API_KEY=
GETYOURGUIDE_PARTNER_ID=
GEOAPIFY_API_KEY=
ATTRACTIONS_CACHE_TTL_MS=900000

# CORS: comma-separated origins (recommended in production), e.g.
# ALLOWED_ORIGINS=https://your-site.netlify.app,https://www.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Stripe checkout requires a secret key, not a restricted key.
STRIPE_SECRET_KEY=

# Visa / GitHub storage (Netlify function)
VISA_ADMIN_TOKEN=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Travel Buddy (Netlify)
TRAVELBUDDY_RAPIDAPI_SECRET=

# Optional: Amadeus (debug scripts only)
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=

# Build/deploy: set to 1 only for local builds that must not touch the database.
SKIP_DB_MIGRATIONS=0

# Scheduler endpoints (/api/cron/*). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Set to 1 when an external cron drives the tracker instead of node-cron in server.js.
DISABLE_IN_PROCESS_CRON=0
